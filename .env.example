# Copy the values you need into your shell or a local .env file.
# AssetFlow reads them from the environment; it does not load .env files itself.

# Database (default: SQLite file at backend/assetflow.db)
# ASSETFLOW_DATABASE_URL=sqlite:////absolute/path/to/assetflow.db

# AI search (optional). Any OpenAI-compatible chat-completions API works.
# Leave these unset to keep AI search switched off.
ASSETFLOW_LLM_BASE_URL=https://api.openai.com/v1
ASSETFLOW_LLM_MODEL=
ASSETFLOW_LLM_API_KEY=

# Local and free with Ollama (no key needed):
# ASSETFLOW_LLM_BASE_URL=http://localhost:11434/v1
# ASSETFLOW_LLM_MODEL=<a model you have pulled>
